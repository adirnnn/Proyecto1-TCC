digraph automata {
    rankdir=LR;
    node [fontname="Helvetica"];
    edge [fontname="Helvetica"];
    labelloc="t";
    label="AFD minimizado - (a|b)*abb(a|b)*";
    __inicio [shape=point width=0.12 label=""];
    "S0" [shape=circle];
    "S1" [shape=circle];
    "S2" [shape=circle];
    "S3" [shape=doublecircle];
    __inicio -> "S0";
    "S0" -> "S1" [label="a"];
    "S0" -> "S0" [label="b"];
    "S1" -> "S1" [label="a"];
    "S1" -> "S2" [label="b"];
    "S2" -> "S1" [label="a"];
    "S2" -> "S3" [label="b"];
    "S3" -> "S3" [label="a, b"];
}
