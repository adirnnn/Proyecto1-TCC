digraph automata {
    rankdir=LR;
    node [fontname="Helvetica"];
    edge [fontname="Helvetica"];
    labelloc="t";
    label="AFD (subconjuntos) - (a|b)*abb(a|b)*";
    __inicio [shape=point width=0.12 label=""];
    "S0" [shape=circle];
    "S1" [shape=circle];
    "S2" [shape=circle];
    "S3" [shape=circle];
    "S4" [shape=doublecircle];
    "S5" [shape=doublecircle];
    "S6" [shape=doublecircle];
    "S7" [shape=doublecircle];
    "S8" [shape=doublecircle];
    __inicio -> "S0";
    "S0" -> "S1" [label="a"];
    "S0" -> "S2" [label="b"];
    "S1" -> "S1" [label="a"];
    "S1" -> "S3" [label="b"];
    "S2" -> "S1" [label="a"];
    "S2" -> "S2" [label="b"];
    "S3" -> "S1" [label="a"];
    "S3" -> "S4" [label="b"];
    "S4" -> "S5" [label="a"];
    "S4" -> "S6" [label="b"];
    "S5" -> "S5" [label="a"];
    "S5" -> "S7" [label="b"];
    "S6" -> "S5" [label="a"];
    "S6" -> "S6" [label="b"];
    "S7" -> "S5" [label="a"];
    "S7" -> "S8" [label="b"];
    "S8" -> "S5" [label="a"];
    "S8" -> "S6" [label="b"];
}
